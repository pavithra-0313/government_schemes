                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"educationLevel\": \"SCHOOL_SECONDARY\",\n  \"currentClassOrYear\": \"Class 10\",\n  \"stream\": \"General\",\n  \"institutionType\": \"Government\",\n  \"previousExamPercentage\": 82.0,\n  \"dateOfBirth\": \"2011-03-20\",\n  \"gender\": \"Male\",\n  \"state\": \"Tamil Nadu\",\n  \"communityCategory\": \"SC\",\n  \"annualFamilyIncome\": 120000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/eligibility/evaluate",
