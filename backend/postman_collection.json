{
  "info": {
    "name": "Student Scholarship & Education Scheme Finder API",
    "_postman_id": "7f7f615a-8dbc-4e9f-853d-240e26c7dd15",
    "description": "Production REST API collection for discovering scholarships, evaluating multi-criteria eligibility, tracking application status, managing document checklists, and scheduling deadline reminders.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "1. Register Student",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('token', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Kavitha Murugan\",\n  \"email\": \"kavitha@example.com\",\n  \"password\": \"User@123\",\n  \"role\": \"USER\",\n  \"preferredLanguage\": \"ta\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "2. Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('token', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@scholarshipfinder.gov.in\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "3. Get Current User Info",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Student Profile",
      "item": [
        {
          "name": "1. Save Undergraduate Profile",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"educationLevel\": \"UNDERGRADUATE\",\n  \"currentClassOrYear\": \"First Year\",\n  \"course\": \"B.E Computer Science\",\n  \"stream\": \"Engineering\",\n  \"institutionName\": \"Government College of Technology\",\n  \"institutionType\": \"Government\",\n  \"institutionLocationType\": \"Urban\",\n  \"boardOrUniversity\": \"Anna University\",\n  \"previousExamPercentage\": 88.5,\n  \"entranceExamScore\": 186.0,\n  \"admissionType\": \"Merit\",\n  \"dateOfBirth\": \"2005-08-14\",\n  \"gender\": \"Female\",\n  \"state\": \"Tamil Nadu\",\n  \"district\": \"Chennai\",\n  \"communityCategory\": \"BC\",\n  \"religionMinorityFlag\": false,\n  \"annualFamilyIncome\": 150000,\n  \"disabilityStatus\": false,\n  \"singleGirlChild\": false,\n  \"firstGraduate\": true,\n  \"orphanOrSingleParent\": false,\n  \"hosteller\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/profile",
              "host": ["{{baseUrl}}"],
              "path": ["profile"]
            }
          }
        },
        {
          "name": "2. Get Current Student Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/profile/me",
              "host": ["{{baseUrl}}"],
              "path": ["profile", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Schemes Catalog",
      "item": [
        {
          "name": "1. List All Schemes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/schemes",
              "host": ["{{baseUrl}}"],
              "path": ["schemes"]
            }
          }
        },
        {
          "name": "2. Search Schemes with Filters",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/schemes?educationLevel=UNDERGRADUATE&state=Tamil Nadu&benefitType=Scholarship",
              "host": ["{{baseUrl}}"],
              "path": ["schemes"],
              "query": [
                {
                  "key": "educationLevel",
                  "value": "UNDERGRADUATE"
                },
                {
                  "key": "state",
                  "value": "Tamil Nadu"
                },
                {
                  "key": "benefitType",
                  "value": "Scholarship"
                }
              ]
            }
          }
        },
        {
          "name": "3. Get Scheme Details By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/schemes/22",
              "host": ["{{baseUrl}}"],
              "path": ["schemes", "22"]
            }
          }
        }
      ]
    },
    {
      "name": "Eligibility Engine",
      "item": [
